# Database (for local dev)
DB_HOST=localhost
DB_USER=root
DB_PASS=root
DB_NAME=cosplay

# Redis
REDIS_HOST=localhost

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cosplay

# JWT - generate a strong secret for production!
JWT_SECRET=your-secret-key

# Admin (seed tạo user đầu tiên)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# SMTP (transactional order emails — left blank, email sending no-ops silently)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public site URL (used to build the order page link + QR code in emails)
SITE_URL=https://your-domain.com

# Shop display name (used in email subjects/templates)
SHOP_NAME=Shop

# Seller's own address — gets a copy of every new order (optional)
ADMIN_EMAIL=

# Goong Maps API key (Vietnam-specific address autocomplete in checkout —
# see frontend/src/components/shop/AddressFields.jsx). Left blank, the
# address field degrades to a plain textarea, so this is optional. This is
# a Vite build-time var baked into the frontend image at `docker compose
# build` — changing it requires a rebuild, not just a container restart.
VITE_GOONG_API_KEY=
